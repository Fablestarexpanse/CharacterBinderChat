{
  "name": "fablechat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "eval": "node tests/memory-eval/run.mjs",
    "eval:long": "node tests/memory-eval/long-chat.mjs",
    "eval:longitudinal": "node tests/memory-eval/longitudinal.mjs",
    "eval:gate": "node --import ./tests/unit/loader.mjs tests/memory-eval/gate-offline.mjs",
    "test": "node --import ./tests/unit/loader.mjs --test \"tests/unit/*.test.mjs\"",
    "test:api": "node --test \"tests/api/*.test.mjs\"",
    "mcp": "node mcp/server.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "better-sqlite3": "^12.10.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^16.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
